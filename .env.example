APP_NAME="Modul Sekolah"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sissekolah.vercel.app

LOG_CHANNEL=stderr
LOG_LEVEL=error

# Database Supabase (PostgreSQL Pooler - direkomendasikan untuk Vercel)
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.<PROJECT_REF>
DB_PASSWORD=
DB_SSLMODE=require

# Supabase API / Storage
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=public

SESSION_DRIVER=cookie
CACHE_STORE=array
QUEUE_CONNECTION=sync
